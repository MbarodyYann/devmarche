# ---------------------------------------------------------------------------
# DevMarché : configuration de PRODUCTION (modèle)
# Copier en /var/www/devmarche/shared/.env, remplir les valeurs marquées « À REMPLIR »,
# puis `php artisan key:generate` une seule fois. Guide : documentation/12-deploiement.md
# Ne jamais committer le vrai fichier .env.
# ---------------------------------------------------------------------------

APP_NAME="DevMarché"
APP_ENV=production
# Généré par `php artisan key:generate` au premier déploiement (À REMPLIR)
APP_KEY=
# Toujours false en production : sinon les erreurs affichent le code et les secrets.
APP_DEBUG=false
# URL publique en HTTPS, sans barre finale (À REMPLIR)
APP_URL=https://devmarche.example

# Démo du jury : connexion en un clic, bandeau et réinitialisation chaque nuit à 3 h.
# true sur l'instance présentée au jury, false sur une instance réelle.
APP_DEMO=true

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Journaux : un fichier par jour, 14 jours gardés, à partir du niveau « warning ».
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=devmarche
DB_USERNAME=devmarche
# Mot de passe long et aléatoire : `openssl rand -base64 32` (À REMPLIR)
DB_PASSWORD=

# Sessions en base ; cookies réservés au HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Aucune tâche en file d'attente pour l'instant : « sync » évite un worker à surveiller.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=devmarche_

# E-mails (réinitialisation du mot de passe). Sans SMTP, laisser « log » : les liens
# arrivent dans storage/logs. Avec un fournisseur SMTP, remplir les lignes suivantes.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@devmarche.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
